# ============================================================================
# Docker Compose Environment Variables for Supabase Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and add your Supabase credentials
# Usage: docker-compose will read these variables automatically

# ===================
# Supabase Configuration (REQUIRED)
# ===================
# Get these values from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===================
# Database Connection (Supabase PostgreSQL)
# ===================
# IMPORTANTE: Usar Connection Pooler para evitar errores IPv6
# Get from: https://supabase.com/dashboard/project/_/settings/database
# → Connection Pooling → Transaction Mode

# Connection Pooler (RECOMENDADO - evita errores ENETUNREACH)
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Nota: Ajusta el host según tu región:
#  - US East: aws-0-us-east-1.pooler.supabase.com
#  - US West: aws-0-us-west-1.pooler.supabase.com
#  - EU Central: aws-0-eu-central-1.pooler.supabase.com

# Alternativa - Direct Connection (puede tener problemas con IPv6):
# DB_HOST=db.your-project-ref.supabase.co
# DB_PORT=5432

# ===================
# Application Configuration
# ===================
NODE_ENV=production
BACKEND_PORT=5001
FRONTEND_PORT=8080

# ===================
# CORS Configuration
# ===================
# Set to your frontend domain in production
CORS_ORIGIN=*

# ===================
# Frontend API URL
# ===================
# URL that the frontend will use to connect to the backend
VITE_API_URL=http://localhost:5001/api
